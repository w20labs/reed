<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime requires these explicit grants. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- We synthesize ⌘V via CGEvent. Hardened runtime needs this to allow
         posting events to other apps. AX permission is still separately
         required at runtime via System Settings. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
